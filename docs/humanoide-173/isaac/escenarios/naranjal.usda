        def "Materiales"
        {
            def Material "corteza"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/corteza/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 1, 1)
                    color3f inputs:diffuseColor.connect = </World/Escenario/Materiales/corteza/Albedo.outputs:rgb>
                    float inputs:metallic = 0
                    float inputs:roughness = 0.65
                    token outputs:surface
                }

                def Shader "Coordenadas"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Albedo"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/../objetos/tree_small_02/textures/tree_small_02_diff_1k.jpg@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Escenario/Materiales/corteza/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
            }

            def Material "hoja_frutal"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/hoja_frutal/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 1, 1)
                    color3f inputs:diffuseColor.connect = </World/Escenario/Materiales/hoja_frutal/Albedo.outputs:rgb>
                    float inputs:metallic = 0
                    float inputs:roughness = 0.65
                    token outputs:surface
                }

                def Shader "Coordenadas"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Albedo"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/../objetos/orange_tree/textures/hoja_huerto.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Escenario/Materiales/hoja_frutal/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
            }

            def Material "oliva"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/oliva/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.27, 0.33, 0.15)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.84
                    token outputs:surface
                }
            }

            def Material "suelo_seco"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/suelo_seco/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 1, 1)
                    color3f inputs:diffuseColor.connect = </World/Escenario/Materiales/suelo_seco/Albedo.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/Escenario/Materiales/suelo_seco/Normal.outputs:rgb>
                    float inputs:roughness = 0.65
                    float inputs:roughness.connect = </World/Escenario/Materiales/suelo_seco/Rugosidad.outputs:r>
                    token outputs:surface
                }

                def Shader "Coordenadas"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @./texturas/brown_mud_dry_nor_gl.jpg@
                    float4 inputs:scale = (2, 2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Escenario/Materiales/suelo_seco/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }

                def Shader "Rugosidad"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/brown_mud_dry_rough.jpg@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Escenario/Materiales/suelo_seco/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "Albedo"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/brown_mud_dry_diffuse.jpg@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Escenario/Materiales/suelo_seco/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
            }
        }

