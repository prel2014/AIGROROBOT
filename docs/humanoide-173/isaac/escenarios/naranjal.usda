#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Perspective = {
                double3 position = (2.2, -1.7, 1.6)
                double3 target = (0, 0.6, 0.95)
            }
        }
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "Fisica" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableGPUDynamics = 0
        token physxScene:solverType = "TGS"
        uint physxScene:timeStepsPerSecond = 120
    }

    def Cube "Suelo" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        float physxCollision:contactOffset = 0.001
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.19, 0.11, 0.055)]
        uniform token purpose = "default"
        double size = 1
        float3 xformOp:scale = (20, 20, 0.07)
        double3 xformOp:translate = (0, 0, -0.035)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DomeLight "Luz"
    {
        float inputs:intensity = 750
    }

    def DistantLight "LuzPrincipal"
    {
        float inputs:intensity = 2000
        float3 xformOp:rotateXYZ = (35, -40, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Xform "Xavier" (
        prepend references = @../humanoide_xavier_isaac.usd@
    )
    {
        double3 xformOp:translate = (0, 0, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "pie_izq" (
            prepend apiSchemas = ["PhysxContactReportAPI"]
        )
        {
            custom float physxContactReport:threshold = 0
        }

        over "pie_der" (
            prepend apiSchemas = ["PhysxContactReportAPI"]
        )
        {
            custom float physxContactReport:threshold = 0
        }

        over "mano_der"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "indice_der_distal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "indice_der_proximal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "medio_der_distal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "medio_der_proximal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "anular_der_distal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "anular_der_proximal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "pulgar_der_distal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "pulgar_der_proximal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "menique_der_distal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }

        over "menique_der_proximal"
        {
            over "Contacto" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Almohadilla>
            }
        }
    }

    def Material "Cascara" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.65
        float physics:restitution = 0
        float physics:staticFriction = 0.85
    }

    def Material "Almohadilla" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.85
        float physics:staticFriction = 1
    }

    def Xform "Naranja" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxContactReportAPI"]
    )
    {
        float physics:mass = 0.095
        custom float physxContactReport:threshold = 0
        double3 xformOp:translate = (0.25, 0.75, 0.87)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "Cascara" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </World/Cascara>
            custom float physxCollision:contactOffset = 0.001
            uniform token purpose = "guide"
            double radius = 0.029
        }

        def Xform "Visual"
        {
            float3 xformOp:scale = (0.7449614, 0.7449614, 0.7449614)
            double3 xformOp:translate = (-0, 1.1102230246251565e-16, -0.038136422634124534)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]

            def Xform "Modelo" (
                prepend references = @./objetos/orange/visual.usda@
            )
            {
            }
        }
    }

    def Xform "ArbolObjetivo"
    {
        def Capsule "Rama" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double height = 0.834640641234298
            color3f[] primvars:displayColor = [(0.2, 0.095, 0.036)]
            double radius = 0.015
            quatd xformOp:orient = (0.7134324797689799, -0.4870186502200298, 0.5038123967793411, 0)
            double3 xformOp:translate = (0.55, 1.04, 0.9724999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Capsule "Pedunculo" (
            delete apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double height = 0.06499999999999995
            color3f[] primvars:displayColor = [(0.2, 0.095, 0.036)]
            double radius = 0.0025
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.25, 0.75, 0.9325)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "Anclaje" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double3 xformOp:translate = (0.25, 0.75, 0.9)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def PhysicsFixedJoint "UnionPedunculo" (
            doc = "Soporte del ensayo. Se libera al comprobar contacto opuesto sostenido para medir la retención de la mano bajo gravedad."
        )
        {
            rel physics:body0 = </World/ArbolObjetivo/Anclaje>
            rel physics:body1 = </World/Naranja>
            bool physics:jointEnabled = 1
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0.03)
        }
    }

    def "Huerto"
    {
        def Xform "Arbol0"
        {
            double3 xformOp:translate = (0.95, 1.45, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Xform "Modelo" (
                instanceable = true
                prepend references = @./objetos/orange_tree/visual.usda@
            )
            {
            }
        }

        def Xform "Arbol1"
        {
            double3 xformOp:translate = (-2, 1.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Xform "Modelo" (
                instanceable = true
                prepend references = @./objetos/orange_tree/visual.usda@
            )
            {
            }
        }

        def Xform "Arbol2"
        {
            double3 xformOp:translate = (0.95, 3.9, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Xform "Modelo" (
                instanceable = true
                prepend references = @./objetos/orange_tree/visual.usda@
            )
            {
            }
        }

        def Xform "Arbol3"
        {
            double3 xformOp:translate = (-2, 3.9, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Xform "Modelo" (
                instanceable = true
                prepend references = @./objetos/orange_tree/visual.usda@
            )
            {
            }
        }
    }
}

