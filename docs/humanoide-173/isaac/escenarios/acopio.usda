#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Perspective = {
                double3 position = (5, -0.85, 1.59)
                double3 target = (-0.4, 6.1, 1.42)
            }
        }
    }
    defaultPrim = "World"
    endTimeCode = 1728000
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @../pista_marcha_16.usda@
    ]
    timeCodesPerSecond = 20
    upAxis = "Z"
)

over "World"
{
    over "Suelo"
    {
        token visibility = "invisible"
        float3 xformOp:scale = (56, 56, 0.07)
    }

    over "Luz"
    {
        float inputs:intensity = 470
        asset inputs:texture:file = @./texturas/kloofendal_48d_partly_cloudy_puresky_1k.hdr@
        token inputs:texture:format = "latlong"
    }

    over "LuzPrincipal"
    {
        float inputs:angle = 3.2
        color3f inputs:color = (1, 0.92, 0.79)
        float inputs:intensity = 880
    }

    def Xform "Escenario"
    {
        def Mesh "TierraAgricola" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-47.5, -45, 0), (47.5, 45, 0)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            rel material:binding = </World/Escenario/Materiales/suelo_seco>
            point3f[] points = [(-47.5, -45, 0), (47.5, -45, 0), (47.5, 45, 0), (-47.5, 45, 0)]
            texCoord2f[] primvars:st = [(-16.964285, -16.071428), (16.964285, -16.071428), (16.964285, 16.071428), (-16.964285, 16.071428)] (
                interpolation = "faceVarying"
            )
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (0, 0, 0.001)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "Materiales"
        {
            def Material "suelo_seco"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/suelo_seco/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 1, 1)
                    color3f inputs:diffuseColor.connect = </World/Escenario/Materiales/suelo_seco/Albedo.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/Escenario/Materiales/suelo_seco/Normal.outputs:rgb>
                    float inputs:roughness = 0.65
                    float inputs:roughness.connect = </World/Escenario/Materiales/suelo_seco/Rugosidad.outputs:r>
                    token outputs:surface
                }

                def Shader "Coordenadas"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @./texturas/brown_mud_dry_nor_gl.jpg@
                    float4 inputs:scale = (2, 2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Escenario/Materiales/suelo_seco/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }

                def Shader "Rugosidad"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/brown_mud_dry_rough.jpg@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Escenario/Materiales/suelo_seco/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "Albedo"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/brown_mud_dry_diffuse.jpg@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Escenario/Materiales/suelo_seco/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
            }

            def Material "hormigon"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/hormigon/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.48, 0.47, 0.43)
                    color3f inputs:diffuseColor.connect = </World/Escenario/Materiales/hormigon/Albedo.outputs:rgb>
                    float inputs:metallic = 0
                    float inputs:roughness = 0.83
                    token outputs:surface
                }

                def Shader "Coordenadas"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Albedo"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/hormigon.jpg@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Escenario/Materiales/hormigon/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
            }

            def Material "grafito"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/grafito/Superficie.outputs:surface>

                def Shader "Superficie"
                {
