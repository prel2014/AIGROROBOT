                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
            }

            def Material "tierra"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/tierra/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.11, 0.075, 0.043)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.98
                    token outputs:surface
                }
            }
        }

