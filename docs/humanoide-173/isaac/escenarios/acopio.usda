                token outputs:surface.connect = </World/Escenario/Materiales/roble/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.48, 0.25, 0.1)
                    color3f inputs:diffuseColor.connect = </World/Escenario/Materiales/roble/Albedo.outputs:rgb>
                    float inputs:metallic = 0
