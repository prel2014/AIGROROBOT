            texCoord2f[] primvars:st = [(35.294117, 0.047058824), (35.294117, -0.047058824), (-35.294117, -0.047058824), (-35.294117, 0.047058824), (35.294117, -0.047058824), (35.294117, 0.047058824), (-35.294117, 0.047058824), (-35.294117, -0.047058824), (35.294117, 35.294117), (35.294117, -35.294117), (-35.294117, -35.294117), (-35.294117, 35.294117), (35.294117, -35.294117), (35.294117, 35.294117), (-35.294117, 35.294117), (-35.294117, -35.294117), (35.294117, 0.047058824), (35.294117, -0.047058824), (-35.294117, -0.047058824), (-35.294117, 0.047058824), (35.294117, -0.047058824), (35.294117, 0.047058824), (-35.294117, 0.047058824), (-35.294117, -0.047058824)] (
                interpolation = "faceVarying"
            )
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (0, 0, -0.08)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "Materiales"
        {
            def Material "hormigon"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/hormigon/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.48, 0.47, 0.43)
                    color3f inputs:diffuseColor.connect = </World/Escenario/Materiales/hormigon/Albedo.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/Escenario/Materiales/hormigon/Normal.outputs:rgb>
                    float inputs:roughness = 0.83
                    float inputs:roughness.connect = </World/Escenario/Materiales/hormigon/Rugosidad.outputs:r>
                    token outputs:surface
                }

                def Shader "Coordenadas"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Albedo"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/servicio_pbr/cemento_color.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Escenario/Materiales/hormigon/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
