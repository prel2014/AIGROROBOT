over "World"
{
    over "Suelo"
    {
        token visibility = "invisible"
        float3 xformOp:scale = (56, 56, 0.07)
    }

    over "Luz"
    {
        float inputs:intensity = 470
        asset inputs:texture:file = @./texturas/kloofendal_48d_partly_cloudy_puresky_1k.hdr@
        token inputs:texture:format = "latlong"
    }

    over "LuzPrincipal"
    {
        float inputs:angle = 3.2
        color3f inputs:color = (1, 0.92, 0.79)
        float inputs:intensity = 880
    }

