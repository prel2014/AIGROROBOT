    defaultPrim = "World"
    endTimeCode = 1728000
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @../pista_marcha_16.usda@
    ]
    timeCodesPerSecond = 20
    upAxis = "Z"
