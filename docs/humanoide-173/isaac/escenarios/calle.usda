#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Perspective = {
                double3 position = (-2.6, -1.7, 1.58)
                double3 target = (4.3, 6.5, 1.6)
            }
        }
    }
    defaultPrim = "World"
    endTimeCode = 1728000
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @../pista_marcha_16.usda@
    ]
    timeCodesPerSecond = 20
    upAxis = "Z"
)

over "World"
{
    over "Suelo"
    {
        token visibility = "invisible"
        float3 xformOp:scale = (56, 56, 0.07)
    }

    over "Luz"
    {
        float inputs:intensity = 470
        asset inputs:texture:file = @./texturas/kloofendal_48d_partly_cloudy_puresky_1k.hdr@
        token inputs:texture:format = "latlong"
    }

    over "LuzPrincipal"
    {
        float inputs:angle = 3.2
        color3f inputs:color = (1, 0.92, 0.79)
        float inputs:intensity = 880
    }

    def Xform "Escenario"
    {
        def Mesh "Calzada" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-28, -26, 0), (28, 26, 0)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            rel material:binding = </World/Escenario/Materiales/asfalto>
            point3f[] points = [(-28, -26, 0), (28, -26, 0), (28, 26, 0), (-28, 26, 0)]
            texCoord2f[] primvars:st = [(-7, -6.5), (7, -6.5), (7, 6.5), (-7, 6.5)] (
                interpolation = "faceVarying"
            )
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (0, 0, 0.001)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "Materiales"
        {
            def Material "asfalto"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/asfalto/Superficie.outputs:surface>

                def Shader "Superficie"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.12, 0.13, 0.13)
                    color3f inputs:diffuseColor.connect = </World/Escenario/Materiales/asfalto/Albedo.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/Escenario/Materiales/asfalto/Normal.outputs:rgb>
                    float inputs:roughness = 0.92
                    float inputs:roughness.connect = </World/Escenario/Materiales/asfalto/Rugosidad.outputs:r>
                    token outputs:surface
                }

                def Shader "Coordenadas"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @./texturas/asphalt_04_nor_gl.jpg@
                    float4 inputs:scale = (2, 2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Escenario/Materiales/asfalto/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }

                def Shader "Rugosidad"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/asphalt_04_rough.jpg@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Escenario/Materiales/asfalto/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "Albedo"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./texturas/asphalt_04_diffuse.jpg@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Escenario/Materiales/asfalto/Coordenadas.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
            }

            def Material "hormigon"
            {
                token outputs:surface.connect = </World/Escenario/Materiales/hormigon/Superficie.outputs:surface>

