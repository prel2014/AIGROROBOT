    over "pie_izq" (
        prepend apiSchemas = ["PhysxContactReportAPI"]
    )
    {
        custom float physxContactReport:threshold = 0

        def "Cargas"
        {
            def Cube "TalonInterior"
            {
                custom int carga:canal = 0
                color3f[] primvars:displayColor = [(0.1, 0.65, 0.95)]
                uniform token purpose = "guide"
                double size = 1
                float3 xformOp:scale = (0.0595, 0.1225, 0.0005)
                double3 xformOp:translate = (0.02975, -0.06125, -0.029)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "TalonExterior"
            {
                custom int carga:canal = 1
                color3f[] primvars:displayColor = [(0.95, 0.5, 0.12)]
                uniform token purpose = "guide"
                double size = 1
                float3 xformOp:scale = (0.0595, 0.1225, 0.0005)
                double3 xformOp:translate = (-0.02975, -0.06125, -0.029)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "AntepieInterior"
            {
                custom int carga:canal = 2
                color3f[] primvars:displayColor = [(0.1, 0.65, 0.95)]
                uniform token purpose = "guide"
                double size = 1
                float3 xformOp:scale = (0.0595, 0.1225, 0.0005)
                double3 xformOp:translate = (0.02975, 0.06125, -0.029)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "AntepieExterior"
