            }
        }
    }

    def PhysicsFixedJoint "hand_attachment"
    {
        rel physics:body0 = </Robot/Arm/wrist_3_link>
        rel physics:body1 = </Robot/Hand/robot0_hand_mount>
        bool physics:collisionEnabled = 0
        point3f physics:localPos0 = (0, 1.3029575e-8, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }
}
