#usda 1.0
(
    defaultPrim = "Model"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Model"
{
    def Xform "Visual" (
        prepend references = @../models/banana_plant/visual.usda@
    )
    {
        over "Geometry"
        {
            over "Peduncle_and_rachis"
            {
                over "Peduncle_and_rachis" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "none"
                }
            }

            over "Pseudostem"
            {
                over "Pseudostem" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "none"
                }
            }
        }
    }
}

