#usda 1.0
(
    defaultPrim = "Obstacle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Obstacle"
{
    def "Materials"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </Obstacle/Materials/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.43, 0.49, 0.5)
                float inputs:metallic = 0.67
                float inputs:roughness = 0.34
                token outputs:surface
            }
        }

        def Material "Grip"
        {
            token outputs:surface.connect = </Obstacle/Materials/Grip/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.69, 0.105, 0.035)
                float inputs:metallic = 0
                float inputs:roughness = 0.56
                token outputs:surface
            }
        }

        def Material "Frame"
        {
            token outputs:surface.connect = </Obstacle/Materials/Frame/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.073, 0.087, 0.096)
                float inputs:metallic = 0.28
                float inputs:roughness = 0.49
                token outputs:surface
            }
        }
    }

    def Capsule "Grip0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.06746851117373201
        rel material:binding = </Obstacle/Materials/Grip>
        double radius = 0.011
        quatd xformOp:orient = (0.7071067811865476, -0.1467276328526115, 0.6917159834480257, 0)
        double3 xformOp:translate = (-0.06, -0.026000000000000002, 0.012)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

