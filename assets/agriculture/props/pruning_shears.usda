        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 7, 7]
        int[] faceVertexIndices = [0, 1, 8, 7, 1, 2, 9, 8, 2, 3, 10, 9, 3, 4, 11, 10, 4, 5, 12, 11, 5, 6, 13, 12, 6, 0, 7, 13, 6, 5, 4, 3, 2, 1, 0, 7, 8, 9, 10, 11, 12, 13]
