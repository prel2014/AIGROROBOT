        uniform token physics:approximation = "convexHull"
        point3f[] points = [(0.004, -0.012, 0.01), (0.046, -0.014, 0.01), (0.074, -0.009, 0.01), (0.099, 0.007, 0.01), (0.081, 0.011, 0.01), (0.045, 0.008, 0.01), (0.02, 0.014, 0.01), (0.004, -0.012, 0.017), (0.046, -0.014, 0.017), (0.074, -0.009, 0.017), (0.099, 0.007, 0.017), (0.081, 0.011, 0.017), (0.045, 0.008, 0.017), (0.02, 0.014, 0.017)]
