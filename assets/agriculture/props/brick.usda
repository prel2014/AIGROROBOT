        point3f[] points = [(-0.07332, -0.03854, 0), (0.0705, -0.03854, 0), (0.08366, -0.03008, 0), (0.0799, 0.03196, 0), (0.06956, 0.03854, 0), (-0.07238, 0.03572, 0), (-0.08178, 0.02538, 0), (-0.08178, -0.02726, 0), (-0.078, -0.041, 0.005), (0.075, -0.041, 0.005), (0.089, -0.032, 0.005), (0.085, 0.034, 0.005), (0.074, 0.041, 0.005), (-0.077, 0.038, 0.005), (-0.087, 0.027, 0.005), (-0.087, -0.029, 0.005), (-0.078, -0.041, 0.047), (0.075, -0.041, 0.047), (0.089, -0.032, 0.047), (0.085, 0.034, 0.047), (0.074, 0.041, 0.047), (-0.077, 0.038, 0.047), (-0.087, 0.027, 0.047), (-0.087, -0.029, 0.047), (-0.07332, -0.03854, 0.054), (0.0705, -0.03854, 0.054), (0.08366, -0.03008, 0.054), (0.0799, 0.03196, 0.054), (0.06956, 0.03854, 0.054), (-0.07238, 0.03572, 0.054), (-0.08178, 0.02538, 0.054), (-0.08178, -0.02726, 0.054)]
