#usda 1.0
(
    defaultPrim = "Obstacle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Obstacle"
{
    def "Materials"
    {
        def Material "Clay"
        {
            token outputs:surface.connect = </Obstacle/Materials/Clay/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.37, 0.117, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Recess"
        {
            token outputs:surface.connect = </Obstacle/Materials/Recess/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.23, 0.075, 0.039)
                float inputs:metallic = 0
                float inputs:roughness = 0.94
                token outputs:surface
            }
        }
    }

