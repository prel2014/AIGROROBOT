#usda 1.0
(
    defaultPrim = "Fruit"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Fruit"
{
    def Xform "Placement"
    {
        double3 xformOp:translate = (-0.1321399323642254, -0.0002466961741447449, 0.018705269321799278)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Model" (
            prepend references = @../models/bananas/bananas_1k.usdc@
        )
        {
            over "bananas_bunch" (
                active = false
            )
            {
            }

            over "bananas_d" (
                active = false
            )
            {
            }

            over "bananas_c" (
                active = false
            )
            {
            }

            over "bananas_b" (
                active = false
            )
            {
            }

            over "bananas_a"
            {
                over "mesh_009" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "convexDecomposition"
                }
            }
        }
    }
}

