#usda 1.0
(
    defaultPrim = "Model"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Model"
{
    def Xform "Visual" (
        prepend references = @../models/vineyard/visual.usda@
    )
    {
        over "Geometry"
        {
            over "vine_row_fruiting_oak"
            {
                over "vine_row_fruiting_oak" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "none"
                }
            }

            over "vine_row_fruiting_timber"
            {
                over "vine_row_fruiting_timber" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "none"
                }
            }

            over "vine_row_fruiting_steel"
            {
                over "vine_row_fruiting_steel" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "none"
                }
            }
        }
    }
}

