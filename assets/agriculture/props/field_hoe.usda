#usda 1.0
(
    defaultPrim = "Obstacle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Obstacle"
{
    def "Materials"
    {
        def Material "Handle"
        {
            token outputs:surface.connect = </Obstacle/Materials/Handle/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.39, 0.248, 0.105)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "Blade"
        {
            token outputs:surface.connect = </Obstacle/Materials/Blade/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.17, 0.18)
                float inputs:metallic = 0.47
                float inputs:roughness = 0.57
                token outputs:surface
            }
        }
    }

    def Capsule "Handle" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.504
        rel material:binding = </Obstacle/Materials/Handle>
        double radius = 0.015
        quatd xformOp:orient = (0.7071067811865476, 0, 0.7071067811865476, 0)
        double3 xformOp:translate = (-0.043, 0, 0.016)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Capsule "Socket" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.067
        rel material:binding = </Obstacle/Materials/Blade>
        double radius = 0.017
        quatd xformOp:orient = (0.7071067811865476, 0, 0.7071067811865476, 0)
        double3 xformOp:translate = (0.2135, 0, 0.018)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Mesh "Blade" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 8, 8]
        int[] faceVertexIndices = [0, 1, 9, 8, 1, 2, 10, 9, 2, 3, 11, 10, 3, 4, 12, 11, 4, 5, 13, 12, 5, 6, 14, 13, 6, 7, 15, 14, 7, 0, 8, 15, 7, 6, 5, 4, 3, 2, 1, 0, 8, 9, 10, 11, 12, 13, 14, 15]
        rel material:binding = </Obstacle/Materials/Blade>
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(0.216, -0.024, 0.001), (0.256, -0.077, 0.001), (0.309, -0.086, 0.001), (0.323, -0.068, 0.001), (0.323, 0.072, 0.001), (0.307, 0.084, 0.001), (0.256, 0.072, 0.001), (0.216, 0.026, 0.001), (0.216, -0.024, 0.007), (0.256, -0.077, 0.007), (0.309, -0.086, 0.007), (0.323, -0.068, 0.007), (0.323, 0.072, 0.007), (0.307, 0.084, 0.007), (0.256, 0.072, 0.007), (0.216, 0.026, 0.007)]
        uniform token subdivisionScheme = "none"
    }
}

