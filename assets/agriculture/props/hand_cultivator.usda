#usda 1.0
(
    defaultPrim = "Obstacle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Obstacle"
{
    def "Materials"
    {
        def Material "Tines"
        {
            token outputs:surface.connect = </Obstacle/Materials/Tines/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.19, 0.21, 0.21)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.46
                token outputs:surface
            }
        }

        def Material "Handle"
        {
            token outputs:surface.connect = </Obstacle/Materials/Handle/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.17, 0.3, 0.14)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Capsule "Grip" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.073
        rel material:binding = </Obstacle/Materials/Handle>
        double radius = 0.015
        quatd xformOp:orient = (0.7071067811865476, 0, 0.7071067811865476, 0)
        double3 xformOp:translate = (-0.0685, 0, 0.018)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

