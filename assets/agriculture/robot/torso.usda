#usda 1.0
(
    defaultPrim = "Torso"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Torso"
{
    def "Materials"
    {
        def Material "Shell"
        {
            token outputs:surface.connect = </Torso/Materials/Shell/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.69, 0.67)
                float inputs:metallic = 0.28
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Frame"
        {
            token outputs:surface.connect = </Torso/Materials/Frame/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.075, 0.11, 0.13)
                float inputs:metallic = 0.52
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }

        def Material "Accent"
        {
            token outputs:surface.connect = </Torso/Materials/Accent/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.28, 0.25)
                float inputs:metallic = 0.18
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }
    }

